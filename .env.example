# ─────────────────────────────────────────────────────────────────────────────
# Mercury — Environment Variable Reference
#
# Copy this file to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (Neon serverless or any PostgreSQL-compatible URL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/mercury?sslmode=require

# ── Optional: FastAPI settings ────────────────────────────────────────────────
# Allowed origins for CORS (comma-separated list of frontend URLs)
# Example: http://localhost:5173,https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:5173

# Application environment (development | staging | production)
ENV=development
APP_ENV=development

# Database connection pool tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=30

# In-memory TTL caching
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_SECONDS=300

# Security & Authentication (Phase 3)
# Set to 'true' in staging/production to require X-API-Key or Bearer token
REQUIRE_AUTH=false
API_KEYS=mercury_test_api_key_12345,mercury_admin_key_67890
JWT_SECRET_KEY=mercury-super-secret-production-key-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate Limiting (Phase 3)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# ── Optional: ML settings ─────────────────────────────────────────────────────
# Number of days of inactivity after which a customer is labelled churned
CHURN_INACTIVITY_DAYS=90
