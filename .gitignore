# ─────────────────────────────────────────────────────────────────────────────
# Mercury .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Secrets and credentials ───────────────────────────────────────────────────
.env
*.env
.env.*
!.env.example

# ── Raw and processed datasets (never commit customer data) ───────────────────
dataset/
data/raw/
data/processed/
Brazilian\ E-Commerce-Public-Dataset-by-Olist/
Marketing-Funnel-by-Olist/
*.csv
*.xlsx
*.xls
*.parquet
*.feather

# ── dbt build artifacts ───────────────────────────────────────────────────────
dbt/mercury_analytics/target/
dbt/mercury_analytics/logs/
dbt/mercury_analytics/profiles.yml   # real credentials — use profiles.yml.example

# ── ML model artifacts ────────────────────────────────────────────────────────
ml/artifacts/
*.pkl
*.joblib
*.h5
*.onnx

# ── Python bytecode and caches ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Jupyter notebooks ─────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Build and distribution ────────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg

# ── macOS system files ────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── IDE and editor ────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── Logs and temporary output ─────────────────────────────────────────────────
*.log
tmp/
temp/

# ── Coverage reports ──────────────────────────────────────────────────────────
.coverage
htmlcov/
coverage.xml

# ── Power BI exports (binary; store in powerbi/ but don't commit large files) ─
*.pbix
